# `make init` copies this to .env and asks for anything it needs, so there is
# normally no reason to edit either by hand. This is the reference for what the
# settings are and what they do.

# Asked for by `make init`.
#
# One directory holds everything this stack owns. `make init` creates
# workspace/ and home/ under it. For example /srv/ai-workspace.
AIWR_ROOT=

# Asked for by `make init`.
#
# Where the backup goes: a directory on storage the OS has already mounted.
# A NAS over cifs or nfs, a second internal disk, a USB enclosure, anything.
# It only ever receives files, so nothing has to be installed on it.
#
# Mount it before running `make init`. An unmounted path is just an empty
# directory, and the backup would fill the Docker host's own disk instead.
BACKUP_MOUNT=

# Asked for by `make init`.
#
# Where your source repositories live on the host, mounted at /src so Claude
# can do coding work in them. For example /srv/src.
#
# Deliberately not under AIWR_ROOT: these are git repositories with their own
# remotes, so they are not in the SMB share and NOT IN THE BACKUP. Unpushed
# work here is not protected against this machine dying.
SRC_MOUNT=

# ---- defaults, nothing below needs touching ----

# The device name shown in claude.ai.
CLAUDE_HOSTNAME=ai-workspace

# acceptEdits | auto | bypassPermissions | default | dontAsk | plan
CLAUDE_PERMISSION_MODE=auto

# The workspace plugin. PLUGIN_REF takes a branch, a tag, or a full 40
# character commit. Empty means the repo's default branch.
#
# On every start the ref is resolved to a commit and compared with what is
# installed, and the plugin is reinstalled only if they differ. So pushing to
# a branch and restarting picks up the new commit even when the version in
# plugin.json has not changed. Leaving this empty means the default branch and
# behaves the same as naming it.
#
# The other two are only for a fork. PLUGIN_REPO=none turns this path off
# entirely, which is what you want once the plugin is listed in
# CLAUDE_PLUGIN_PATHS instead.
PLUGIN_REF=
#PLUGIN_NAME=ai-workspace
#PLUGIN_REPO=sebmartin/ai-workspace-plugin

# Which plugins Claude starts with. Both are empty by default, because which
# plugins a workspace wants is your choice rather than this repo's.
#
# CLAUDE_MARKETPLACES is a space-separated list of marketplace sources to
# register: a GitHub repo, a URL, or a path. CLAUDE_PLUGINS is a
# space-separated list of plugin ids to install from them, each one
# name@marketplace. The marketplace name comes from the marketplace's own
# manifest, which is usually but not always the last part of the repo name.
#
# Anthropic publishes a marketplace of its own, and these two are a
# reasonable starting point if you want them:
#
#   CLAUDE_MARKETPLACES=anthropics/claude-plugins-official
#   CLAUDE_PLUGINS=superpowers@claude-plugins-official plugin-dev@claude-plugins-official
CLAUDE_MARKETPLACES=
CLAUDE_PLUGINS=

# Plugins you are developing, as a space-separated list of paths under /src.
# Each one needs a .claude-plugin/plugin.json, and the name in it is the name
# the plugin is installed under.
#
# These are reinstalled from disk on every start, because installing copies the
# plugin and `plugin update` only notices a bumped version number. So editing
# one takes effect on `make restart`, not on save.
CLAUDE_PLUGIN_PATHS=

# Which host interface publishes port 445. Narrow it to one LAN address if
# the box is on a network you do not control.
SMB_BIND_IP=0.0.0.0

# How often the workspace is snapshotted, which is your RPO.
BACKUP_COMMIT_CRON=7 * * * *

TZ=UTC

# ---- written by `make init`, do not edit ----
WORKSPACE_UID=
WORKSPACE_GID=
