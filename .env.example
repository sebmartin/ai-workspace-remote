# `make init` copies this to .env and asks for anything it needs, so there is
# normally no reason to edit either by hand. This is the reference for what the
# settings are and what they do.

# Asked for by `make init`.
#
# One directory holds everything this stack owns. `make init` creates
# workspace/ and home/ under it. For example /srv/ai-workspace.
AIWR_ROOT=

# Asked for by `make init`.
#
# Where the backup goes: a directory on storage the OS has already mounted.
# A NAS over cifs or nfs, a second internal disk, a USB enclosure, anything.
# It only ever receives files, so nothing has to be installed on it.
#
# Mount it before running `make init`. An unmounted path is just an empty
# directory, and the backup would fill the Docker host's own disk instead.
BACKUP_MOUNT=

# ---- defaults, nothing below needs touching ----

# Where your source repositories live, mounted at /src so Claude can do
# coding work in them. Empty means src/ under AIWR_ROOT, which `make init`
# creates. Set it only if your code lives somewhere else.
#
# Either way it is a sibling of workspace/ rather than inside it, so it is not
# in the SMB share and NOT IN THE BACKUP. Unpushed work there is not protected
# against this machine dying.
SRC_MOUNT=

# The device name shown in claude.ai.
CLAUDE_HOSTNAME=ai-workspace

# acceptEdits | auto | bypassPermissions | default | dontAsk | plan
CLAUDE_PERMISSION_MODE=auto

# Which plugins Claude starts with, space separated. Empty means none,
# because which plugins a workspace wants is your choice rather than this
# repo's. Three kinds of entry:
#
#   /src/my-plugin             a directory you are working in. Reinstalled on
#                              every start, so edits take effect on
#                              `make restart` rather than on save.
#   name@owner/repo#ref        a plugin repo at a branch, tag or full 40
#                              character commit. #HEAD for the default branch.
#                              The ref is resolved and compared on every start,
#                              so pushing to the branch and restarting picks up
#                              the new commit.
#   name@source                a marketplace, installed by version. The source
#                              is a GitHub repo, a URL or a path. A bare name
#                              with no slash is a marketplace already
#                              registered in the container.
#
# Anthropic publishes a marketplace of its own, and these two are a reasonable
# starting point if you want them:
#
#   CLAUDE_PLUGINS=superpowers@anthropics/claude-plugins-official plugin-dev@anthropics/claude-plugins-official
CLAUDE_PLUGINS=

# Which host interface publishes port 445. Narrow it to one LAN address if
# the box is on a network you do not control.
SMB_BIND_IP=0.0.0.0

# How often the workspace is snapshotted, which is your RPO.
BACKUP_COMMIT_CRON=7 * * * *

TZ=UTC

# ---- written by `make init`, do not edit ----
WORKSPACE_UID=
WORKSPACE_GID=
