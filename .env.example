# Copy to .env and fill in.
#
# Keep comments on their own lines. An inline `# comment` after a value
# survives as trailing whitespace when the Makefile includes and exports this
# file, and compose then prefers that padded value over the one it would have
# parsed correctly.

# --- host paths ---------------------------------------------------------

# One root holds everything this stack owns. `make dirs` creates it, chowns it
# to the uid below and sets it 0700, then puts three directories under it:
#
#   workspace/  the git repo, shared over SMB, where the agent works
#   home/       Claude's home, so .claude/ and .claude.json
#   backup/     local bare repo and job state, staging for the NAS mirror
#
# home/ is deliberately a sibling of workspace/ rather than a child. Inside the
# workspace it would be committed, shared over SMB and mirrored to the NAS.
#
# Point this somewhere else and you have a second, fully isolated stack, which
# is how to try this out without touching a real workspace.
AIWR_ROOT=/srv/ai-workspace

WORKSPACE_UID=1000
WORKSPACE_GID=1000

# --- claude-remote ------------------------------------------------------

# The device name shown in claude.ai. Changing it needs a recreate.
CLAUDE_HOSTNAME=ai-workspace

# acceptEdits | auto | bypassPermissions | default | dontAsk | plan
CLAUDE_PERMISSION_MODE=auto

# --- plugin -------------------------------------------------------------

# The workspace plugin, installed on every start. Set PLUGIN_REF to a branch,
# tag or commit to test one. Empty means the repo's default branch.
PLUGIN_REF=

# Only needed if you forked the plugin. These are the defaults.
#PLUGIN_NAME=ai-workspace
#PLUGIN_REPO=sebmartin/ai-workspace-plugin

# --- samba --------------------------------------------------------------

# The password is a file, not a setting here. Run `make smb-password`.
SMB_PASSWORD_FILE=./secrets/smb_password

# Narrow this to a LAN address in production.
SMB_BIND_IP=0.0.0.0

# --- backup -------------------------------------------------------------

NAS_HOST=
NAS_PORT=22
NAS_USER=

# One root on the NAS, holding workspace.git and claude-home. This is the
# backup. The backup/ directory on the Docker host is not, it is staging.
# The parent directories must already exist, rsync creates only the last one.
NAS_ROOT=/volume1/backups/ai-workspace

NAS_SSH_KEY_HOST_PATH=./secrets/id_backup
NAS_KNOWN_HOSTS_HOST_PATH=./secrets/known_hosts

# How often the workspace is snapshotted, which is your RPO. Nothing
# accumulates, so lowering it costs almost nothing. The mirror runs hourly
# and the gc weekly, both fixed.
BACKUP_COMMIT_CRON=7 * * * *

# Cron schedules use this.
TZ=UTC
