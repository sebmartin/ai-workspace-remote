# Where everything lives, and where the backup goes.
# Set these two, then run `make init`.

# One directory holds everything this stack owns. `make init` creates
# workspace/ and home/ under it. For example /srv/ai-workspace.
AIWR_ROOT=

# Where the backup goes: a directory on storage the OS has already mounted.
# A NAS over cifs or nfs, a second internal disk, a USB enclosure, anything.
# It only ever receives files, so nothing has to be installed on it.
#
# Mount it before running `make init`. An unmounted path is just an empty
# directory, and the backup would fill the Docker host's own disk instead.
BACKUP_MOUNT=

# ---- defaults, nothing below needs touching ----

# The device name shown in claude.ai.
CLAUDE_HOSTNAME=ai-workspace

# acceptEdits | auto | bypassPermissions | default | dontAsk | plan
CLAUDE_PERMISSION_MODE=auto

# A branch, tag or commit of the workspace plugin. Empty is its default branch.
PLUGIN_REF=

# Which host interface publishes port 445. Narrow it to one LAN address if
# the box is on a network you do not control.
SMB_BIND_IP=0.0.0.0

# How often the workspace is snapshotted, which is your RPO.
BACKUP_COMMIT_CRON=7 * * * *

TZ=UTC

# Only if you forked the plugin.
#PLUGIN_NAME=ai-workspace
#PLUGIN_REPO=sebmartin/ai-workspace-plugin

# ---- written by `make init`, do not edit ----
WORKSPACE_UID=
WORKSPACE_GID=
