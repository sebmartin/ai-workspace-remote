# Where everything lives, and how to reach the backup.
# Set these four, then run `make init`.

# One directory holds everything this stack owns. `make init` creates
# workspace/, home/ and backup/ under it. For example /srv/ai-workspace.
AIWR_ROOT=

# The machine the backup is mirrored to, over SSH. It only ever receives
# files, so it needs nothing installed on it.
NAS_HOST=
NAS_USER=
NAS_ROOT=

# ---- defaults, nothing below needs touching ----

# The device name shown in claude.ai.
CLAUDE_HOSTNAME=ai-workspace

# acceptEdits | auto | bypassPermissions | default | dontAsk | plan
CLAUDE_PERMISSION_MODE=auto

# A branch, tag or commit of the workspace plugin. Empty is its default branch.
PLUGIN_REF=

# Which host interface publishes port 445. Narrow it to one LAN address if
# the box is on a network you do not control.
SMB_BIND_IP=0.0.0.0

NAS_PORT=22

# How often the workspace is snapshotted, which is your RPO. Nothing
# accumulates, so lowering it costs almost nothing.
BACKUP_COMMIT_CRON=7 * * * *

TZ=UTC

# Only if you forked the plugin.
#PLUGIN_NAME=ai-workspace
#PLUGIN_REPO=sebmartin/ai-workspace-plugin

# ---- written by `make init`, do not edit ----
WORKSPACE_UID=
WORKSPACE_GID=
