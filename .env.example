# Copy to .env and fill in.

# --- host paths, must exist and be owned by WORKSPACE_UID:WORKSPACE_GID ---
WORKSPACE_HOST_PATH=/srv/ai-workspace        # the workspace, a git repo
CLAUDE_HOME_HOST_PATH=/srv/claude-home       # Claude's auth, sessions, plugins
BACKUP_STATE_HOST_PATH=/srv/backup           # local bare repo and job state

WORKSPACE_UID=1000
WORKSPACE_GID=1000

# --- claude-remote ------------------------------------------------------
CLAUDE_HOSTNAME=ai-workspace                 # the device name in claude.ai
CLAUDE_PERMISSION_MODE=auto

# --- plugin -------------------------------------------------------------
# The workspace plugin, installed on every start. Set PLUGIN_REF to a branch,
# tag or commit to test one. Empty means the repo's default branch.
PLUGIN_REF=

# Only needed if you forked the plugin. These are the defaults.
#PLUGIN_NAME=ai-workspace
#PLUGIN_REPO=sebmartin/ai-workspace-plugin

# --- samba --------------------------------------------------------------
# The password is a file, not a setting here. Run `make smb-password`.
SMB_PASSWORD_FILE=./secrets/smb_password
SMB_BIND_IP=0.0.0.0                          # narrow to a LAN address in production

# --- backup -------------------------------------------------------------
NAS_HOST=
NAS_PORT=22
NAS_USER=
NAS_PATH=/volume1/backups/claude/workspace.git
NAS_TRANSCRIPTS_PATH=/volume1/backups/claude/claude-home
NAS_SSH_KEY_HOST_PATH=./secrets/id_backup
NAS_KNOWN_HOSTS_HOST_PATH=./secrets/known_hosts

# How often the workspace is snapshotted. This is your RPO, and also how
# many mid-edit intermediate versions end up stored forever.
BACKUP_COMMIT_CRON=7 * * * *                  # mirror is hourly, gc weekly

TZ=UTC                                        # cron schedules use this
